# Lakebase (autoscaling Postgres) Configuration
LAKEBASE_PROJECT_ID=<PROJECT_ID>            # autoscaling project_id (w.postgres project)
LAKEBASE_DATABASE_NAME=<DATABASE_NAME>      # postgres database (default: databricks_postgres)
LAKEBASE_CATALOG_NAME=<CATALOG_NAME>        # UC catalog backed by the postgres database
LAKEBASE_BRANCH=production                  # branch for the endpoint + synced table (main | production)
LAKEBASE_ENDPOINT=primary                   # read-write endpoint id on the branch
DATABRICKS_DATABASE_PORT=5432
# In a deployed Databricks App, DATABRICKS_CLIENT_ID is injected automatically as the
# app's service principal id; the app uses it for OAuth and for create-app-credentials.

# Synced Table Storage (synced_tables API -> new_pipeline_spec.storage_catalog / storage_schema)
SYNCED_TABLE_STORAGE_CATALOG=<STORAGE_CATALOG>
SYNCED_TABLE_STORAGE_SCHEMA=<STORAGE_SCHEMA>

# Table Configuration (synced table destination schema/table the app queries)
DEFAULT_POSTGRES_SCHEMA=<SCHEMA_NAME>
DEFAULT_POSTGRES_TABLE=<TABLE_NAME>

# Databricks App Authentication
# Local dev: leave these commented and use your CLI profile (`databricks auth login`).
# Uncomment and fill ONLY for explicit token auth / production. Leaving literal
# placeholders uncommented breaks auth (the SDK reads them and overrides your profile).
# DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_TOKEN=dapi...
# DATABRICKS_CLIENT_ID=<SERVICE_PRINCIPAL_CLIENT_ID> # optional: used as the Postgres role/username

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_COMMAND_TIMEOUT=30
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE_INTERVAL=3600

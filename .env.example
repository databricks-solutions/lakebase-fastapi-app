# LOCAL DEV config only. When DEPLOYED as a Databricks App, the Lakebase resource
# binding auto-injects PGHOST/PGPORT/PGDATABASE/PGUSER/PGSSLMODE, and ENDPOINT_NAME
# is injected by databricks.yml — so you configure NOTHING here for deployment.
#
# For LOCAL dev, set the ONE endpoint identifier below. The app derives the host
# from it, the user from your CLI identity (or DATABRICKS_CLIENT_ID), and the
# database defaults to databricks_postgres.
ENDPOINT_NAME=projects/<PROJECT_ID>/branches/production/endpoints/primary

# Synced table location — read by the post-deploy grant script (scripts/grant_app_access.py).
DEFAULT_POSTGRES_SCHEMA=public
DEFAULT_POSTGRES_TABLE=orders_synced

# Auth: local dev uses your CLI profile (`databricks auth login`). Uncomment ONLY
# for explicit token auth (leaving literal placeholders set breaks profile auth).
# DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_TOKEN=dapi...

# Optional connection-pool tuning (code defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_COMMAND_TIMEOUT=30
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE_INTERVAL=2700
